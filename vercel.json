{
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "functions": {
    "api/sincronizar.js": { "maxDuration": 60 },
    "api/eventos.js": { "maxDuration": 30 },
    "api/avisos.js": { "maxDuration": 60 },
    "api/painel.js": { "maxDuration": 60 },
    "api/ficha.js": { "maxDuration": 30 },
    "api/contagem.js": { "maxDuration": 30 },
    "api/semanal.js": { "maxDuration": 60 },
    "api/revisao360.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/sincronizar", "schedule": "0 9 * * *" },
    { "path": "/api/avisos", "schedule": "0 11 * * *" }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/api/app" }
  ]
}
